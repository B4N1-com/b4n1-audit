<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>B4n1Audit</RootNamespace>
    <AssemblyName>B4n1Audit</AssemblyName>
    <Version>0.1.5</Version>
    <Authors>Bani Montoya</Authors>
    <Email>banimontoya@gmail.com</Email>
    <Description>B4N1 Audit SDK for .NET — security &amp; code quality scanner with bundled binary</Description>
    <PackageTags>security;audit;scanner;sarif;static-analysis</PackageTags>
    <PackageProjectUrl>https://b4n1.com</PackageProjectUrl>
    <PackageLicenseFile>BUSL-1.1.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Company>B4N1</Company>
    <!-- Packaging/license: public package (task 952f7022). -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\BUSL-1.1.txt" Pack="true" PackagePath="\" />
    <None Include="EULA.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Binarios empaquetados por plataforma (build-binaries.sh los copia aquí). -->
  <ItemGroup>
    <Content Include="native\**" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="native\" />
  </ItemGroup>

</Project>
